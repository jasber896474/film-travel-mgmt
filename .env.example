# 勘景系統（掛在 film-travel-mgmt 的 Vercel）
# 把這個檔複製成 .env.local，並到 Vercel → film-travel-mgmt → Settings → Environment Variables 填同一組。

SCOUTING_SUPABASE_URL=https://knoudnzjnfkfhiizgcna.supabase.co
SCOUTING_SUPABASE_SERVICE_ROLE_KEY=
SCOUTING_ADMIN_KEY=

# pCloud Public Folder（照片）。沒設的話，文字建檔仍可用，上傳相機會提示未設定。
PCLOUD_HOST=api.pcloud.com
PCLOUD_ACCESS_TOKEN=
PCLOUD_PUBLIC_FOLDER_ID=
PCLOUD_FILEDN_BASE=https://filedn.com/你的PublicFolder代號
